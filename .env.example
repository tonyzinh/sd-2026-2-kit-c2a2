# Deixe LLM_API_KEY vazia para usar o MODO SIMULADO (offline)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini
URL_INGESTAO=http://localhost:8001
URL_RECUPERACAO=http://localhost:8002
# Resiliencia (opcionais)
LLM_TIMEOUT=20
BREAKER_LIMITE_FALHAS=3
BREAKER_ESPERA=20
# Fila / indice (no Docker o compose ja define)
REDIS_URL=redis://localhost:6379/0
INDICE_PATH=dados/indice.json
# Injecao de falha no LLM, so para demonstracao (deixe desligado):
# LLM_SIMULAR_FALHA=1
# LLM_SIMULAR_FALHA_TAXA=0.7
